extends SceneTree
const Data = preload("res://Game/Scripts/CardSystem/CardCatalog.gd")
func _init() -> void:
 var doc = "# 卡牌与路线说明\n\n全部 %d 种卡牌（通用 %d 种，每路线12种），每张均有升级版。数据来自 Game/Resources/Cards 下的独立 Resource。\n\n首回合抽5张，之后每回合保留手牌并抽2张，上限10张。满手牌时不继续抽取，牌留在抽牌堆。已打出的普通牌进入弃牌堆；能力牌与紧急救护本场移出，下场恢复。\n\n出战卡组限制15–30张，各路线内按基础费用升序排列，X费列最后；费用“3→2”表示升级降费。\n\n初始卡组17张：奋力挥击×3、稳固防御×2、迅捷连击×2、横扫四方×1、战术调整×2、敏锐洞察×1、博闻强识×1，加5张当前路线牌。\n\n" % [Data.CARDS.size(), Data.card_count("neutral")]
 for route in ["neutral", "venom", "bastion", "fury"]:
  doc += "## " + ("通用" if route == "neutral" else Data.ROUTES[route].name) + "\n\n| 卡牌 | 类型 | 费用 | 基础效果 | 升级效果 |\n| --- | --- | --- | --- | --- |\n"
  for id in Data.sorted_card_ids(route):
   var c = Data.card(id)
   if c.route != route: continue
   doc += "| %s | %s | %s | %s | %s |\n" % [c.name,c.kind,Data.cost_text(c) + ("→" + Data.cost_text(Data.card(id + "+")) if c.cost != Data.card(id + "+").cost else ""),Data.describe(c).replace("\n","；"),Data.describe(Data.card(id+"+")).replace("\n","；")]
  doc += "\n"
 doc += "## 结算说明\n\n- 以战养战下一回合所有对敌伤害附带75%吸血，按实际生命伤害逐段向下取整治疗；包含毒素、毒素引爆、反伤，持续至再下一玩家回合开始。\n- 逆境觉醒为本场能力：生命严格低于35%（升级50%）时，每段对敌伤害独立有50%（升级60%）几率翻倍。生命回到门槛以上立即停止触发，不叠加概率。\n- 振奋战吼立即获得6（升级9）临时力量，本玩家回合结束时移除；不影响永久力量。\n- 背水一击按当前已损失生命的50%（升级60%）向下取整计算基础伤害，再加力量。\n- 乱刃连斩每段独立随机选择存活敌人，可重复选中同一目标，淬毒对每个命中且存活目标仅触发一次。\n- 虚弱使攻击伤害降低30%，易伤使普通伤害增加20%；两者基础持续1回合、升级持续2回合；敌方阶段结束时减少1回合，重复施加取较长剩余时间。易伤沿用原范围，不增强毒素、毒素引爆与碎甲重击。\n- 透支潜能先自伤，致死则立即战败；孤注一掷先造成45（升级55）伤害，未击杀目标才失去10生命。蛋壳结界仍可抵挡自伤。\n- 全能身手先结算伤害，再增加力量；原有力量仍加成攻击。\n- 碎甲重击不受力量、易伤影响，按移除护甲量造成伤害，零护甲即零伤害。\n- 冰封万象跳过敌人下一次行动，毒素照常结算；连续冰冻不会累加跳过次数。\n- 蛋壳结界先于护甲抵挡一次正伤害，包括自伤；多段攻击只抵挡其中一段。可叠加次数，跨回合保留，下场清零。升级后反弹被抵挡伤害的50%（基础值向下取整），反弹给实际攻击者并沿用普通对敌伤害结算；自伤没有攻击者，不反弹。\n- 厚积薄发按实际消耗能量计入下一回合，允许X=0；升级后本回合立即额外获得1点能量，下回合仍只额外获得原先消耗的X。\n- 卸劲调息、紧急救护、全能身手可治疗旧伤；汲取生机沿用上轮伤势限制。\n- 起始专属牌：蚀毒为毒刃突袭×2、毒雾屏障、毒性催化、腐蚀毒液；铁壁为坚盾护身×2、重盾猛击、固守不移、整装待发；狂刃为连环挥击×2、坚定战意、孤注一掷、振奋战吼。\n"
 doc += "\n- 震慑心神使单个目标跳过下一次行动，毒素照常结算；与冰冻同时存在时共同消耗，不额外叠加跳过次数。\n- 灵感迸发先从牌堆预取3张（升级4张），再依次免费使用；牌堆不足时洗入弃牌堆。预取牌不占手牌位，其他抽牌仍遵守10张上限。X牌以当前能量为X但不扣能量；毒素不足的牌进入弃牌堆；胜负后停止使用剩余牌。自动牌正常计入连击齿轮，单次出牌最多连续自动结算64张。\n- 发条炸弹为2费能力牌，锁定目标，于下一玩家回合结束、敌人行动前造成21（升级28）点基础伤害，不加力量，沿用易伤、逆境觉醒与吸血规则；原目标死亡时转向首个存活敌人。\n- 盯紧破绽持续本回合及下回合（两次敌方阶段结束后移除），攻击牌每段暴击率增加20（升级30）个百分点，与逆境觉醒相加、上限100%，只掷一次；不提高毒素、反伤或炸弹的暴击率。重复施加取最高概率和最长时间。\n- 背水之力在出牌时按已损失生命的15%（升级20%）向下取整，安排下回合临时力量，之后回血或受伤不改变已排定数值；可与振奋战吼和永久力量叠加，分别到期移除。\n- 卸甲重击先清空自身护甲，再按消耗量的2倍（升级2.5倍，向下取整）加力量造成普通攻击伤害；荆棘穿刺计入永久与临时反伤，但不消耗反伤。\n- 毒性发作要求目标至少1层毒，立即造成一次穿甲毒素伤害，随后减1层；升级不减层。趁毒追击按目标当前毒层增加普通攻击伤害，最多10（升级15），不消耗毒素。\n"
 doc += "\n## 遗物\n\n| 遗物 | 效果 |\n| --- | --- |\n"
 for id in Data.RELICS:
  doc += "| %s | %s |\n" % [Data.RELICS[id].name, Data.RELICS[id].desc]
 doc += "\n## 难度\n\n轻松、标准、勇者战败可重新开始本小关，恢复开战时的状态；传奇沿用勇者敌人数值，战败不能重试，只能从头开始。\n"
 var file = FileAccess.open("res://卡牌与路线说明.md", FileAccess.WRITE)
 file.store_string(doc)
 print("Exported ", Data.CARDS.size(), " card definitions.")
 quit()
