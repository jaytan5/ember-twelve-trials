extends SceneTree
const Data = preload("res://scripts/data.gd")

func _init() -> void:
 var text_value = "# 卡牌与路线说明\n\n当前共 **46 种基础卡牌**：通用 16 种，蚀毒、铁壁、狂刃各 10 种。每张均有升级版，升级不改变能量费用。下表由游戏配置自动生成，伤害未计入力量、易伤和遗物加成。\n\n"
 text_value += "## 三条路线的核心玩法\n\n| 路线 | 核心玩法一 | 核心玩法二 | 关键规则 |\n| --- | --- | --- | --- |\n"
 text_value += "| 蚀毒 | 毒刃、淬毒、疫潮叠毒，催化放大持续伤害 | 毒爆清空毒层爆发；毒素回收消耗 4 层换下回合能量 | 淬毒按攻击牌触发，多段只触发一次，全体攻击向每个存活目标施毒；毒爆无视护甲且不受力量、易伤影响 |\n"
 text_value += "| 铁壁 | 重盾、固守、钢铁壁垒叠甲，盾击和钢甲冲撞将护甲转伤 | 反震、棘甲、荆棘生长累积反伤；反击风暴主动输出后仍能反击 | 反伤在每段敌方攻击后触发，完全挡住伤害也有效；盾击、冲撞、风暴不消耗护甲或反伤 |\n"
 text_value += "| 狂刃 | 战意增加力量，双连斩、疾风三连让每段攻击获得加成 | 嗜战、怒吼、血性冲锋积攒狂怒，怒斩消耗全部狂怒加伤 | 嗜战在每张攻击牌结算后触发一次；怒斩先消费现有狂怒，再触发嗜战；狂怒跨回合保留 |\n\n"
 text_value += "例如：铁壁拥有 20 护甲时，基础盾击造成 22 点基础伤害；拥有 6 反伤时，基础反击风暴对全体造成 24 点基础伤害。狂刃拥有 5 狂怒时，基础怒斩造成 6 + 5×3 = 21 点基础伤害，再计算力量与易伤。\n\n"
 for route in ["neutral", "venom", "bastion", "fury"]:
  text_value += "## " + ("通用卡牌（16 种）" if route == "neutral" else Data.ROUTES[route].name + "路线（10 种）") + "\n\n"
  text_value += "| 卡牌 | 类型 | 能量 | 基础效果 | 升级后效果 |\n| --- | --- | ---: | --- | --- |\n"
  for id in Data.CARDS:
   var card = Data.card(id)
   if card.route != route: continue
   text_value += "| %s | %s | %d | %s | %s |\n" % [card.name, card.kind, card.cost, Data.describe(card).replace("\n", "；"), Data.describe(Data.card(id + "+")).replace("\n", "；")]
  text_value += "\n"
 text_value += "## 卡组管理\n\n- 每局拥有的卡分为出战卡组与备用卡库。出战上限 30 张、下限 5 张，重复卡分别计数；只有出战卡参与下一场战斗的抽牌。\n- 战后选牌、选遗物和营火阶段可以编辑；战斗与结算阶段仅查看。\n- 从右上角「卡组」进入，将卡牌拖到另一侧；也可点击卡牌，在详情中选择移入。拖出后保留卡牌，免费且自动保存。\n- 出战满 30 张后，奖励或商店的新卡自动进入备用卡库，并弹出卡组管理。先拖出旧卡，再拖入新卡；不需要凑满 30 张才能出发。\n- 卡牌升级状态与重复副本都会保留。旧版存档自动兼容：超出 30 的牌转入备用卡库，不重洗正在进行的战斗；后续关卡使用新的出战卡组。\n- 商店的「永久删牌」仍会真正删除选中的卡，区别于免费移入备用卡库。\n\n"
 text_value += "## 状态与顺序\n\n毒素在敌人行动前结算，无视护甲，随后层数减 1；淬毒是玩家本场战斗的持续能力，每张攻击牌结算后向命中且存活的敌人施加等于淬毒值的毒素。嗜战按其数值提供狂怒；反伤、力量、淬毒、嗜战与狂怒都在下一场战斗开始时重置。\n\n只有能力牌生效后移入「已激活」，下场恢复。攻击和技能进入弃牌堆，可以循环使用。未雨绸缪的额外护甲在下回合清空旧护甲后获得，额外抽牌仍受手牌上限 10 张限制。碎甲击先清空敌人护甲再造成伤害；佯攻、识破先伤害再施加状态；毒素回收在目标不足 4 层毒时无法出牌。钢甲冲撞取当前护甲的一半，向下取整。\n\n初始卡组仍为 11 张：斩击×3、防守×3、战术调整×1，再加所选路线的 4 张初始牌。新的卡牌通过正常战后奖励与商店获得；图鉴可以查看全卡池，但不会直接授予卡牌。\n"
 text_value += "\n\n卡牌治疗仅恢复上一轮敌方攻击造成的未恢复伤势，多张共享额度；药水也会扣减该额度，下一轮敌方行动开始时过期。燃血自伤和旧伤不能靠卡牌恢复。棘甲反伤仅持续至下个玩家回合开始，其他反伤能力持续整场。振作、毒素回收提供下回合额外能量；催化翻倍最多新增12层，升级18层。\n"
 var file = FileAccess.open("res://卡牌与路线说明.md", FileAccess.WRITE)
 if file == null:
  printerr("Cannot export card guide")
  quit(1)
  return
 file.store_string(text_value)
 print("Exported 46-card guide with upgrades.")
 quit()
