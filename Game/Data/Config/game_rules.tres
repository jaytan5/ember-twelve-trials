[gd_resource type="Resource" script_class="" load_steps=2 format=3]

[ext_resource type="Script" path="res://Game/Scripts/CardSystem/GameConfig.gd" id="1"]

[resource]
script = ExtResource("1")
initial_hand = 5
turn_draw = 2
hand_limit = 10
initial_common = ["strike", "strike", "strike", "guard", "guard", "quick", "quick", "sweep", "focus", "focus", "insight", "erudition"]
routes = {"bastion": {"cards": ["fortify", "fortify", "shield_bash", "hold", "shield_draw"], "color": "85b5f5", "desc": "叠甲后重盾猛击，或累积反伤、释放飞刺齐发。\n初始遗物：每个玩家回合开始获得 3 护甲。", "hp": 88, "name": "铁壁", "relic": "iron_core", "tag": "护甲转伤 / 荆棘反击"}, "fury": {"cards": ["cleave", "cleave", "rage", "execute", "warcry"], "color": "f08e85", "desc": "力量强化多段攻击；以战养战恢复生命，低血量触发暴击。\n初始遗物：每场战斗开始获得 1 点力量。", "hp": 82, "name": "狂刃", "relic": "blade_core", "tag": "力量连击 / 吸血暴击"}, "venom": {"cards": ["sting", "sting", "toxic_guard", "catalyst", "corrosion"], "color": "75cbb3", "desc": "叠毒与淬毒持续侵蚀，或消耗毒层引爆、回能。\n初始遗物：每场战斗首次施毒额外 +2 层。", "hp": 76, "name": "蚀毒", "relic": "venom_core", "tag": "叠毒侵蚀 / 毒层引爆"}}
difficulties = {"easy": {"action_scale": 1, "desc": "显示敌人攻击、防御与蓄力预告；敌人数值为基础值。战败可重新开始本小关。", "hp_scale": 1, "name": "轻松", "show_intents": true, "allow_retry": true}, "normal": {"action_scale": 1, "desc": "隐藏敌人下一步行动及伤害预告；敌人数值为基础值。战败可重新开始本小关。", "hp_scale": 1, "name": "标准", "show_intents": false, "allow_retry": true}, "hard": {"action_scale": 1.25, "desc": "隐藏预告；敌人生命 +35%，攻击、防御、蓄力 +25%（向上取整）。战败可重新开始本小关。", "hp_scale": 1.35, "name": "勇者", "show_intents": false, "allow_retry": true}, "legendary": {"action_scale": 1.25, "desc": "敌人数值与勇者相同，隐藏预告。无法重试小关，战败只能从第一关重新冒险。", "hp_scale": 1.35, "name": "传奇", "show_intents": false, "allow_retry": false}}
chapters = ["汤泉村落", "街口集市", "飞机展馆", "汤山洞穴"]
